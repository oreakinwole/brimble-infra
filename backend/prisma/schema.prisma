generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Deployment {
  id         String   @id @default(uuid())
  sourceType String
  source     String
  status     String
  imageTag   String?
  url        String?
  createdAt  DateTime @default(now())
}

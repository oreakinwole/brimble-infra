generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Deployment {
  id         String   @id @default(uuid())
  sourceType String
  source     String
  status     String   // pending, building, deploying, running, failed
  imageTag   String?
  url        String?
  port       String?
  createdAt  DateTime @default(now())
}
